[Unit]
Description=AnonTrace private relay
After=network.target

[Service]
User=anontrace
WorkingDirectory=/opt/anontrace-relay
ExecStart=/opt/anontrace-relay/anontrace-relay 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/anontrace-relay

[Install]
WantedBy=multi-user.target
